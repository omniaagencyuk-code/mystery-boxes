# Copy this file to .env.local and fill in the values yourself.
# .env.local is gitignored. This example file contains variable NAMES ONLY.

# Supabase project URL, e.g. https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase PUBLISHABLE key (current key format, starts with sb_publishable_).
# This is the replacement for the legacy anon JWT. Safe to expose to the browser.
# It is subject to Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase SECRET key (current key format, starts with sb_secret_).
# This is the replacement for the legacy service_role JWT. It BYPASSES Row Level
# Security. Server side only. Never expose it to the browser and never prefix it
# with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Public base URL of the deployed site, used for canonical URLs, sitemap and
# hreflang. No trailing slash. e.g. https://mystery-boxes.com
NEXT_PUBLIC_SITE_URL=
